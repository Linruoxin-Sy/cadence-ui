{
  "name": "cadence-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Animation-first React components for shadcn. Base UI + Tailwind CSS v4 + Motion.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "upstream:sync": "node scripts/sync-upstream.mjs",
    "parity:check": "node scripts/parity.mjs",
    "llms:build": "node scripts/build-llms.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm registry:check && pnpm parity:check && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "motion": "^13.5.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.32",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
