{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cadence",
  "homepage": "https://cadence.dev",
  "items": [
    {
      "name": "cadence-base",
      "type": "registry:base",
      "title": "Cadence base",
      "description": "Pins a Cadence project to Base UI, lucide icons, and the neutral shadcn theme.",
      "style": "base-ui",
      "iconLibrary": "lucide",
      "baseColor": "neutral",
      "theme": "neutral"
    },
    {
      "name": "cadence-motion",
      "type": "registry:lib",
      "title": "Motion presets",
      "description": "Durations, easings, springs, and recipe resolution shared by every Cadence component.",
      "categories": ["foundation"],
      "files": [
        {
          "path": "registry/cadence/lib/motion.ts",
          "type": "registry:lib",
          "target": "@components/cadence/lib/motion.ts"
        }
      ]
    },
    {
      "name": "cadence-utils",
      "type": "registry:lib",
      "title": "Utilities",
      "description": "The cn() helper every Cadence component uses to merge Tailwind classes.",
      "categories": ["foundation"],
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "registry/cadence/lib/cn.ts",
          "type": "registry:lib",
          "target": "@components/cadence/lib/cn.ts"
        }
      ]
    },
    {
      "name": "cadence-provider",
      "type": "registry:lib",
      "title": "Provider",
      "description": "Optional provider that wires prefers-reduced-motion, motion intensity, and shared defaults into one MotionConfig.",
      "categories": ["foundation"],
      "dependencies": ["motion"],
      "registryDependencies": ["cadence-motion", "cadence-utils"],
      "files": [
        {
          "path": "registry/cadence/lib/provider.tsx",
          "type": "registry:lib",
          "target": "@components/cadence/lib/provider.tsx"
        }
      ]
    },
    {
      "name": "cadence-theme",
      "type": "registry:theme",
      "title": "Cadence theme",
      "description": "Motion CSS variables and intensity rules layered on top of the shadcn theme.",
      "categories": ["foundation"],
      "cssVars": {
        "theme": {
          "--ease-cadence-out": "cubic-bezier(0.22, 1, 0.36, 1)",
          "--ease-cadence-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
        },
        "light": {
          "--motion-distance-sm": "8px",
          "--motion-distance-md": "12px",
          "--motion-intensity": "1"
        },
        "dark": {
          "--motion-distance-sm": "8px",
          "--motion-distance-md": "12px",
          "--motion-intensity": "1"
        }
      },
      "css": {
        "@layer base": {
          "[data-motion='reduced']": {
            "--motion-distance-sm": "4px",
            "--motion-distance-md": "6px"
          },
          "[data-motion='none']": {
            "--motion-distance-sm": "0px",
            "--motion-distance-md": "0px"
          },
          "@media (prefers-reduced-motion: reduce)": {
            ":root": {
              "--motion-distance-sm": "0px",
              "--motion-distance-md": "0px"
            }
          }
        }
      }
    },
    {
      "name": "fade-in",
      "type": "registry:ui",
      "title": "Fade in",
      "description": "Reveal content on scroll with a short rise and a reduced-motion fallback.",
      "categories": ["text", "motion"],
      "dependencies": ["motion"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/fade-in/fade-in.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/fade-in/fade-in.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["reveal"],
        "intensity": "subtle",
        "complexity": "S"
      }
    },
    {
      "name": "text-reveal",
      "type": "registry:ui",
      "title": "Text reveal",
      "description": "Reveal a heading or paragraph word by word, with a single accessible sentence.",
      "categories": ["text", "motion"],
      "dependencies": ["motion"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/text-reveal/text-reveal.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/text-reveal/text-reveal.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["text.reveal", "reveal"],
        "intensity": "medium",
        "complexity": "M"
      }
    },
    {
      "name": "number-flow",
      "type": "registry:ui",
      "title": "Number flow",
      "description": "A number that rolls from its previous value to the next, with a static accessible value.",
      "categories": ["feedback", "motion"],
      "dependencies": ["motion"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/number-flow/number-flow.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/number-flow/number-flow.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["number.roll"],
        "intensity": "medium",
        "complexity": "M"
      }
    },
    {
      "name": "morph-button",
      "type": "registry:ui",
      "title": "Morph button",
      "description": "A button whose label and width morph between idle, loading, success, and error.",
      "categories": ["feedback", "motion"],
      "dependencies": ["motion", "lucide-react"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/morph-button/morph-button.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/morph-button/morph-button.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["state.morph", "feedback.press"],
        "intensity": "medium",
        "complexity": "M"
      }
    },
    {
      "name": "animated-tabs",
      "type": "registry:ui",
      "title": "Animated tabs",
      "description": "Tabs with a shared-element indicator and an animated panel swap.",
      "categories": ["navigation", "motion"],
      "dependencies": ["motion"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/animated-tabs/animated-tabs.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/animated-tabs/animated-tabs.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["layout.shared", "reveal"],
        "intensity": "medium",
        "complexity": "M"
      }
    },
    {
      "name": "motion-accordion",
      "type": "registry:ui",
      "title": "Motion accordion",
      "description": "An accordion whose panels spring open and closed, with a rotating chevron.",
      "categories": ["navigation", "motion"],
      "dependencies": ["motion", "lucide-react"],
      "registryDependencies": ["cadence-motion", "cadence-utils", "cadence-provider"],
      "files": [
        {
          "path": "registry/cadence/motion-accordion/motion-accordion.tsx",
          "type": "registry:ui",
          "target": "@components/cadence/motion-accordion/motion-accordion.tsx"
        }
      ],
      "meta": {
        "since": "0.1.0",
        "motion": ["state.morph"],
        "intensity": "medium",
        "complexity": "M"
      }
    }
  ]
}
