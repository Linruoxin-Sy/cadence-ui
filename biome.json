{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-*",
      "!**/.cache",
      "!**/coverage",
      "!**/public/r",
      "!**/public/llms.txt",
      "!**/public/llms-full.txt",
      "!app/typeset.css",
      "!.agents",
      "!skills-lock.json",
      "!**/.workbuddy",
      "!test-results",
      "!**/upstream/manifest.json",
      "!**/*.mdx",
      "!next-env.d.ts",
      "!**/*.tsbuildinfo",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noPlaywrightMissingAwait": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/e2e/**", "playwright.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noPlaywrightMissingAwait": "on"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "arrowParentheses": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
